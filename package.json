{
  "name": "wanigan",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop control surface for local coding agents. Run a crew of Claude Code and Codex sessions across every repo from one window.",
  "author": "Dead North LLC",
  "homepage": "https://wanigan.deadnorth.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deadnorth/wanigan.git"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-rebuild -f -w node-pty,better-sqlite3",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3",
    "dist:mac": "electron-vite build && { electron-builder --mac; c=$?; npm run rebuild; exit $c; }",
    "install:mac:arm64": "node scripts/install-local-macos.cjs",
    "dist:mac:arm64:install": "npm run dist:mac:arm64 && npm run install:mac:arm64",
    "test:shared": "node --test src/shared/*.test.ts",
    "test:renderer-style": "node scripts/check-renderer-style.cjs",
    "test:dead-code": "knip --exclude exports,types,nsExports,nsTypes,enumMembers,classMembers,duplicates",
    "shots": "node scripts/shots.mjs",
    "shots:browser": "node scripts/shots-browser.mjs",
    "probe:chords": "node scripts/probe-chords.mjs",
    "probe:preflight": "node scripts/probe-preflight.mjs",
    "probe:terminal": "node scripts/probe-terminal-replay.mjs",
    "probe:handover": "node scripts/probe-handover.mjs",
    "probe:recent": "node scripts/probe-recent-names.mjs",
    "test:package-hooks": "node scripts/test-package-hooks.cjs",
    "test:local-install": "node scripts/test-local-macos-install.cjs",
    "app": "./scripts/launch.sh",
    "cli": "./scripts/cli.sh",
    "smoke": "./scripts/smoke.sh",
    "test": "npm run typecheck && npm run test:shared && npm run test:renderer-style && npm run test:dead-code && npm run test:lint && npm run test:package-hooks && npm run test:local-install && npm run smoke",
    "dist:mac:arm64": "electron-vite build && { electron-builder --mac --arm64; c=$?; npm run rebuild; exit $c; }",
    "dead-code:all": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:debt": "node scripts/lint-debt.cjs",
    "test:lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "better-sqlite3": "13.0.3",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "@webgpu/types": "^0.1.72",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "knip": "5.66.2",
    "playwright-core": "1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "7.3.6"
  }
}
