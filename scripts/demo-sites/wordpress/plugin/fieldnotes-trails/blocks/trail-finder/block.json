{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fieldnotes/trail-finder",
	"version": "1.0.0",
	"title": "Trail finder",
	"category": "widgets",
	"icon": "location-alt",
	"description": "Every trail, narrowed by difficulty and season as the reader chooses, with distances in kilometres or miles.",
	"keywords": [ "trails", "filter", "hike" ],
	"textdomain": "fieldnotes-trails",
	"attributes": {
		"showUnits": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"interactivity": true,
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
