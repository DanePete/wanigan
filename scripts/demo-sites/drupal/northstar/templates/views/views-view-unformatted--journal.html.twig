{#
/**
 * @file
 * Journal entries: a northstar:card-grid of story cards, three across.
 */
#}
{% set cards %}
  {% for row in rows %}
    <div{{ row.attributes.addClass('card-grid__item') }}>{{- row.content -}}</div>
  {% endfor %}
{% endset %}
{{ include('northstar:card-grid', { columns: 3, kind: 'stories', items: cards }, with_context = false) }}
