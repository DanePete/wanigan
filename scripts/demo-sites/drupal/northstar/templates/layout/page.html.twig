{#
/**
 * @file
 * Northstar's page: announcement bar, a sticky header with the mega menu,
 * the main column (with a sidebar when it has blocks) and the footer.
 *
 * Variables added in northstar_preprocess_page(): year, demo_note.
 * page--node--landing-page.html.twig replaces the main block to run edge to edge.
 */
#}
<div class="site">
  <a href="#main-content" class="skip-link visually-hidden focusable">{{ 'Skip to main content'|t }}</a>
  {{ page.announcement }}

  <header class="site-header" role="banner" data-site-header>
    <div class="site-header__inner container">
      {{ page.header }}
      <div class="site-header__nav" id="site-nav">
        {{ page.primary_menu }}
        {{ page.header_tools }}
      </div>
      <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        {{ include('northstar:icon', { name: 'menu', attributes: create_attribute({ class: ['site-header__open'] }) }, with_context = false) }}
        {{ include('northstar:icon', { name: 'close', attributes: create_attribute({ class: ['site-header__close'] }) }, with_context = false) }}
        <span class="visually-hidden">{{ 'Menu'|t }}</span>
      </button>
    </div>
  </header>

  {{ page.highlighted }}

  {% block main %}
    <main class="site-main" role="main">
      <a id="main-content" tabindex="-1"></a>
      <div class="container">
        {{ page.breadcrumb }}
        {{ page.content_above }}
        <div class="main-grid{{ page.sidebar ? ' main-grid--with-sidebar' }}">
          <div class="main-grid__content">
            {{ page.content }}
          </div>
          {% if page.sidebar %}
            <aside class="main-grid__sidebar" role="complementary">
              {{ page.sidebar }}
            </aside>
          {% endif %}
        </div>
        {{ page.content_below }}
      </div>
    </main>
  {% endblock %}

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__top container">
      <div class="site-footer__brand">
        <img src="{{ base_path ~ directory }}/logo.svg" alt="" width="44" height="44">
        <p>{{ 'Goods for long days outside, made a few at a time near the lake.'|t }}</p>
      </div>
      {{ page.footer_top }}
    </div>
    <div class="site-footer__bottom container">
      <p class="site-footer__legal">© {{ year }} Northstar Storefront. {{ demo_note }}</p>
      {{ page.footer_bottom }}
    </div>
  </footer>
</div>
