{#
/**
 * @file
 * A product's pictures, drawn by the northstar:gallery component. Each
 * picture keeps its item attributes, so its place in the field can be read
 * from the page. count comes from northstar_preprocess_field().
 */
#}
{% set pictures %}
  {% for item in items %}
    <figure{{ item.attributes.addClass('gallery__item') }}>{{ item.content }}</figure>
  {% endfor %}
{% endset %}
<div{{ attributes.addClass('field', 'field--field-images') }}>
  {{ include('northstar:gallery', {
    count: count,
    label: 'Pictures of @name'|t({ '@name': element['#object'].label }),
    items: pictures,
  }, with_context = false) }}
</div>
