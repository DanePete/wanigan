{#
/**
 * @file
 * A journal entry, in full: byline with reading time, picture, text, what
 * to shop from the story, tags.
 *
 * Variables added in northstar_preprocess_node(): reading_time, date,
 * author_label.
 */
#}
<article{{ attributes.addClass('node', 'node--article', 'article') }}>
  {{ title_prefix }}{{ title_suffix }}
  <p class="article__meta">
    <span class="article__author">{{ 'By'|t }} {{ author_label }}</span>
    <span aria-hidden="true">·</span>
    <time datetime="{{ node.createdtime|date('c') }}">{{ date }}</time>
    <span aria-hidden="true">·</span>
    <span>{{ reading_time }}</span>
  </p>
  <div class="article__image">{{ content.field_image }}</div>
  <div class="article__columns">
    <div{{ content_attributes.addClass('article__body', 'prose') }}>
      {{ content.field_trip }}
      {{ content.body }}
      {{ content.field_tags }}
    </div>
  </div>
  {{ content.field_products }}
</article>
