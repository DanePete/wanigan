{#
/**
 * @file
 * A plain page or any content without its own template.
 */
#}
<article{{ attributes.addClass('node', 'node--' ~ node.bundle|clean_class, view_mode ? 'node--' ~ view_mode|clean_class) }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes.addClass('node__title') }}><a href="{{ url }}" rel="bookmark">{{ label }}</a></h2>
  {% endif %}
  {{ title_suffix }}
  <div{{ content_attributes.addClass('node__content', 'prose') }}>
    {{ content }}
  </div>
</article>
