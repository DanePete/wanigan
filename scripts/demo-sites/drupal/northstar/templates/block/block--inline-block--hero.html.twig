{#
/**
 * @file
 * Layout Builder's inline hero block, drawn by the northstar:hero component.
 *
 * Its words are fields printed bare (field--bare.html.twig), so each stays
 * the field it is. heading_level and cta come from northstar_preprocess_block().
 */
#}
<div{{ attributes.addClass('block', 'block--hero') }}>
  {{ title_prefix }}{{ title_suffix }}
  {{ include('northstar:hero', {
    heading_level: heading_level,
    cta_label: cta.label,
    cta_url: cta.url,
    media: content.field_image,
    kicker: content.field_kicker,
    heading: content.field_heading,
    text: content.field_summary,
  }, with_context = false) }}
</div>
