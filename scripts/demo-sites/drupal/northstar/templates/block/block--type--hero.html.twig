{#
/**
 * @file
 * A hero block, reusable or inline in Layout Builder, drawn by the
 * northstar:hero component. Suggested by northstar_theme_suggestions_block_alter()
 * (block--type--BUNDLE). Its words are fields printed bare
 * (field--bare.html.twig), so each stays the field it is. heading_level, look
 * and cta come from northstar_preprocess_block().
 */
#}
<div{{ attributes.addClass('block', 'block--hero') }}>
  {{ title_prefix }}{{ title_suffix }}
  {{ include('northstar:hero', {
    look: look,
    heading_level: heading_level,
    cta_label: cta.label,
    cta_url: cta.url,
    media: content.field_media,
    kicker: content.field_kicker,
    heading: content.field_heading,
    text: content.field_summary,
  }, with_context = false) }}
</div>
