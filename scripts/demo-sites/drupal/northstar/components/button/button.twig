{#
/**
 * @file
 * Button: a link when it has an address, otherwise a button.
 */
#}
{% set classes = ['button', 'button--' ~ (variant|default('primary'))] %}
{% if url %}
  <a{{ attributes.addClass(classes).setAttribute('href', url) }}>{{ label }}{% if arrow %}{{ include('northstar:icon', { name: 'arrow', attributes: create_attribute({ class: ['button__arrow'] }) }, with_context = false) }}{% endif %}</a>
{% else %}
  <button{{ attributes.addClass(classes).setAttribute('type', 'button') }}>{{ label }}</button>
{% endif %}
