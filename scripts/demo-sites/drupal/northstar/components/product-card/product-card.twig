{#
/**
 * @file
 * Product card: the whole card is one link to the product; badges sit on the
 * picture.
 */
#}
<div{{ attributes.addClass('product-card') }}>
  <a class="product-card__link" href="{{ url }}">
    <div class="product-card__media">{% block media %}{{ media }}{% endblock %}</div>
    <div class="product-card__body">
      {% if category %}<p class="product-card__category">{{ category }}</p>{% endif %}
      <h3 class="product-card__title">{% block title %}{{ title }}{% endblock %}</h3>
      <div class="product-card__price">{% block price %}{{ price }}{% endblock %}</div>
    </div>
  </a>
  {% if has_badges %}
    <div class="product-card__badges">{% block badges %}{{ badges }}{% endblock %}</div>
  {% endif %}
</div>
