<?php

/**
 * @file
 * Northstar's preprocess functions and template suggestions.
 *
 * Every function here changes something a visitor can see, so a trace of the
 * page has real theme code to point at: the price and its shipping note, a
 * sale, a product's category line, a journal entry's byline and reading
 * time, an event's date tile, a block's colour, icon and heading level, the
 * menu's descriptions, the language switcher's short names, and which
 * template draws a block, a field or a page.
 */

use Drupal\block\Entity\Block;
use Drupal\Core\Render\Element;
use Drupal\node\NodeInterface;

/**
 * Orders at or above this many dollars ship free.
 */
const NORTHSTAR_FREE_SHIPPING = 75;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function northstar_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'northstar';
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $variables['attributes']['class'][] = 'page--' . str_replace('_', '-', $node->bundle());
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['attributes']['class'][] = 'page--front';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function northstar_preprocess_page(array &$variables): void {
  $variables['year'] = date('Y');
  $variables['demo_note'] = t('A made-up shop for Wanigan’s demo. Nothing here is for sale.');
  // Products and landing pages print their own title (beside the gallery, or
  // in the hero), so the page title block steps aside on them.
  $node = $variables['node'] ?? NULL;
  if ($node instanceof NodeInterface && in_array($node->bundle(), ['product', 'landing_page'], TRUE)) {
    unset($variables['page']['content_above']['northstar_page_title']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function northstar_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $formatter = \Drupal::service('date.formatter');
  switch ($node->bundle()) {
    case 'product':
      $price = (float) $node->get('field_price')->value;
      $was = (float) $node->get('field_compare_price')->value;
      $variables['ships_free'] = $price >= NORTHSTAR_FREE_SHIPPING;
      $variables['on_sale'] = $was > $price;
      $term = $node->get('field_category')->entity;
      if ($term) {
        $term = \Drupal::service('entity.repository')->getTranslationFromContext($term);
        $variables['category'] = $term->label();
        $variables['category_url'] = $term->toUrl()->toString();
      }
      $variables['attributes']['class'][] = $variables['ships_free'] ? 'product--ships-free' : 'product--ships-paid';
      $variables['shipping_note'] = $variables['ships_free']
        ? t('This one ships free, and comes back free for a season.')
        : t('Free shipping on orders over $@amount, and free returns for a season.', ['@amount' => NORTHSTAR_FREE_SHIPPING]);
      break;

    case 'article':
      $words = str_word_count(strip_tags((string) $node->get('body')->value));
      $variables['reading_time'] = \Drupal::translation()->formatPlural(max(1, (int) round($words / 200)), '1 min read', '@count min read');
      $variables['date'] = $formatter->format($node->getCreatedTime(), 'custom', 'j F Y');
      $variables['author_label'] = $node->getOwner()->getDisplayName();
      break;

    case 'event':
      $when = $node->get('field_when')->first();
      if ($when) {
        $start = $when->start_date;
        $end = $when->end_date;
        $tz = date_default_timezone_get();
        $variables['day'] = $start->format('j', ['timezone' => $tz]);
        $variables['month'] = $start->format('M', ['timezone' => $tz]);
        $variables['weekday'] = $start->format('l', ['timezone' => $tz]);
        $variables['time_range'] = $start->format('g:i a', ['timezone' => $tz]) . ' – ' . $end->format('g:i a', ['timezone' => $tz]);
      }
      break;
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.html.twig.
 */
function northstar_preprocess_field(array &$variables): void {
  $name = $variables['element']['#field_name'] ?? '';
  $items = $variables['element']['#items'] ?? NULL;
  $entity = $variables['element']['#object'] ?? NULL;
  if ($name === 'field_price' && $items && $entity) {
    $amount = (float) $items->value;
    $was = (float) $entity->get('field_compare_price')->value;
    $variables['amount'] = $amount;
    $variables['was'] = $was > $amount ? $was : NULL;
    $variables['ships_free'] = $amount >= NORTHSTAR_FREE_SHIPPING;
    $variables['note'] = $variables['ships_free']
      ? t('Ships free')
      : t('Free shipping over $@amount', ['@amount' => NORTHSTAR_FREE_SHIPPING]);
  }
  if ($name === 'field_badges' && $items) {
    $labels = $items->getFieldDefinition()->getFieldStorageDefinition()->getSetting('allowed_values');
    foreach ($variables['items'] as $delta => &$item) {
      $key = (string) $items->get($delta)->value;
      $item['tone'] = $key;
      $item['label'] = $labels[$key] ?? $key;
    }
  }
  if ($name === 'field_media' && $entity instanceof NodeInterface && $entity->bundle() === 'product') {
    $variables['count'] = count($variables['items']);
    $variables['product_label'] = $entity->label();
  }
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 *
 * A content block, inline in Layout Builder or reusable, hands its link,
 * colour, icon, look and heading level to the component that draws it.
 */
function northstar_preprocess_block(array &$variables): void {
  $block = $variables['content']['#block_content'] ?? NULL;
  if (!$block) {
    return;
  }
  $variables['bundle'] = $block->bundle();
  if ($block->hasField('field_link') && ($link = $block->get('field_link')->first())) {
    $variables['cta'] = ['label' => $link->title, 'url' => $link->getUrl()->toString()];
  }
  if ($block->hasField('field_tone')) {
    $variables['tone'] = $block->get('field_tone')->value ?: 'pine';
  }
  if ($block->hasField('field_icon')) {
    $variables['icon'] = $block->get('field_icon')->value ?: 'star';
  }
  if ($block->hasField('field_style')) {
    $variables['look'] = $block->get('field_style')->value ?: 'overlay';
  }
  if ($block->hasField('field_reverse')) {
    $variables['reverse'] = (bool) $block->get('field_reverse')->value;
  }
  if ($block->bundle() === 'hero') {
    // A hero opens the page, so its heading is the page's h1.
    $variables['heading_level'] = 1;
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu--main.html.twig.
 *
 * Adds each link's description, shown under it in the open menu.
 */
function northstar_preprocess_menu__main(array &$variables): void {
  $describe = function (array &$items) use (&$describe): void {
    foreach ($items as &$item) {
      $item['description'] = $item['original_link']->getDescription();
      if (!empty($item['below'])) {
        $describe($item['below']);
      }
    }
  };
  $describe($variables['items']);
}

/**
 * Implements hook_preprocess_HOOK() for links--language-block.html.twig.
 *
 * Short names (EN, FR) in the header, with the language's own name kept for
 * screen readers.
 */
function northstar_preprocess_links__language_block(array &$variables): void {
  foreach ($variables['links'] as $langcode => &$link) {
    if (isset($link['link']['#title'])) {
      $link['full'] = $link['link']['#title'];
      $link['link']['#title'] = strtoupper($langcode);
      $link['link']['#options']['attributes']['aria-label'] = (string) $link['full'];
      $link['link']['#options']['attributes']['lang'] = $langcode;
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block templates.
 *
 * Adds block--REGION as the least specific suggestion, so a region can style
 * its plain blocks without naming each one; and block--type--BUNDLE for a
 * content block, so a hero looks the same inline or reusable.
 */
function northstar_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $id = $variables['elements']['#id'] ?? NULL;
  if ($id && ($block = Block::load($id))) {
    array_unshift($suggestions, 'block__' . $block->getRegion());
  }
  $content = $variables['elements']['content'] ?? [];
  if (!empty($content['#block_content'])) {
    $suggestions[] = 'block__type__' . $content['#block_content']->bundle();
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page templates.
 *
 * Adds page--node--BUNDLE, so a landing page can run edge to edge.
 */
function northstar_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for field templates.
 *
 * Adds field--ENTITY--FIELD--BUNDLE--VIEW-MODE (a product card shows only its
 * first picture), and field--bare for words printed inside a component's
 * heading or paragraph, where a wrapping div would not be allowed.
 */
function northstar_theme_suggestions_field_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'];
  $bare = $element['#entity_type'] === 'block_content' && in_array($element['#field_name'], ['field_kicker', 'field_heading', 'field_summary', 'field_number', 'field_cite'], TRUE);
  if ($bare || $element['#field_name'] === 'field_where') {
    $suggestions[] = 'field__bare';
    return;
  }
  $suggestions[] = 'field__' . $element['#entity_type'] . '__' . $element['#field_name'] . '__' . $element['#bundle'] . '__' . $element['#view_mode'];
}

/**
 * Implements hook_preprocess_HOOK() for views-view.html.twig.
 *
 * Says which listing it is, for its wrapper's class.
 */
function northstar_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  $variables['listing'] = $view->id() . '--' . $view->current_display;
  $variables['is_block'] = $view->getDisplay()->getPluginId() === 'block';
}

/**
 * Implements hook_preprocess_HOOK() for status-messages.html.twig.
 */
function northstar_preprocess_status_messages(array &$variables): void {
  $variables['icons'] = ['status' => 'check', 'warning' => 'alert', 'error' => 'alert'];
}
